# ─── Database (server-side only) ──────────────────────────────
# Neon POOLED connection string — host contains "-pooler".
# Pooled matters: Vercel runs the API as serverless functions that spin
# up per request, and direct connections exhaust Postgres's limit fast.
DATABASE_URL=

# DIRECT connection (no "-pooler" in the host). Used by migrations and seed
# scripts ONLY. DDL and session-scoped work must not run through Neon's
# transaction pooler (PgBouncer). Standard Neon / Prisma two-URL pattern.
DIRECT_URL=

# ─── Auth: three separate tokens, never shared ────────────────
# Each guards a different surface through its own FastAPI dependency (see
# apps/api/app/auth.py). They are separate so that rotating one — because a
# kid's friend photographed the iPad, or a phone was lost — does not break the
# others, and so a leak of one cannot reach what the others guard.
# Generate each with:  openssl rand -hex 32

# The wall iPad. Same value gets pasted into its one-time setup screen.
DEVICE_TOKEN=

# The nightly materializer. Vercel Cron sends it as a bearer token. This guards
# the only endpoint that WRITES without a human deciding to, so leaving it unset
# means "deny everyone" — a misconfigured deploy shows up as a red cron run,
# never as an open write endpoint on a public URL.
CRON_SECRET=

# The late-chore summary at GET /api/outstanding, held by an iOS Shortcut.
# Read-only, but it names who in this house has not done what, so unset also
# means "deny everyone".
OUTSTANDING_TOKEN=

# ─── API config ───────────────────────────────────────────────
# Comma-separated origins allowed to call the API.
# Local dev + your deployed web URL.
ALLOWED_ORIGINS=http://localhost:5173

# Resolves what "today" means on the board.
APP_TIMEZONE=America/Chicago

# The household this kiosk serves. Explicit on purpose — not an implicit
# "first row" lookup — so it survives into the next slice (later it comes off
# the device record). Must match household.id in your seed.json.
HOUSEHOLD_ID=00000000-0000-0000-0000-000000000001

# ─── Web (PUBLIC — Vite inlines this into the browser bundle) ─
# Only variables that are safe to publish may be prefixed VITE_.
VITE_API_BASE_URL=http://localhost:8000