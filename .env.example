# ─── Database (server-side only) ──────────────────────────────
# Neon POOLED connection string — host contains "-pooler".
# Pooled matters: Vercel runs the API as serverless functions that spin
# up per request, and direct connections exhaust Postgres's limit fast.
DATABASE_URL=

# ─── Kiosk auth (server-side only) ────────────────────────────
# openssl rand -hex 32
# Same value gets pasted into the iPad's one-time setup screen.
DEVICE_TOKEN=

# ─── API config ───────────────────────────────────────────────
# Comma-separated origins allowed to call the API.
# Local dev + your deployed web URL.
ALLOWED_ORIGINS=http://localhost:5173

# Resolves what "today" means on the board.
APP_TIMEZONE=America/Chicago

# ─── Web (PUBLIC — Vite inlines this into the browser bundle) ─
# Only variables that are safe to publish may be prefixed VITE_.
VITE_API_BASE_URL=http://localhost:8000